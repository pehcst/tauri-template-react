{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri React",
  "version": "0.1.0",
  "identifier": "com.example.taurireacttemplate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1429",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri React",
        "width": 900,
        "height": 620,
        "minWidth": 600,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http: ws:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
